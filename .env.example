# Copy this file to `.env` and fill in your Supabase project's values.
# Find these under Project Settings → API in the Supabase dashboard.
# Never commit the real `.env` file — it's already in .gitignore.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Data source switch — supabase | backend. Defaults to supabase if unset.
# Only Auth + Category Management have a real "backend" implementation so
# far; every other feature still requires Supabase regardless of this flag.
DATA_SOURCE=supabase
BACKEND_BASE_URL=http://localhost:3000/api/v1

# Google Sign-In server client ID (web OAuth client) for POST /auth/oauth in
# backend mode. Optional — defaults to the project's existing web client ID
# in google-services.json/GoogleService-Info.plist if unset.
GOOGLE_SERVER_CLIENT_ID=

# iOS OAuth client (client_type: 2) — required as GoogleSignIn's `clientId:`
# on iOS. Optional — defaults to the project's existing iOS client ID if unset.
GOOGLE_IOS_CLIENT_ID=
